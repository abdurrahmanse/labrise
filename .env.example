# --- Data source -------------------------------------------------------------
# Leave everything empty to run on the bundled data (mock mode). No backend needed.

# Backend the BROWSER calls, e.g. https://api.example.com . Empty = the site's own /api routes.
NEXT_PUBLIC_API_BASE_URL=
# "mock" | "rest". Empty = rest when a base URL is set, otherwise mock.
NEXT_PUBLIC_DATA_PROVIDER=
# development | staging | production
NEXT_PUBLIC_APP_ENV=development

# --- Server only (never sent to the browser) ---------------------------------
# Backend the SERVER calls while rendering. Falls back to NEXT_PUBLIC_API_BASE_URL.
API_BASE_URL=
# Bearer token the server sends to the backend.
API_TOKEN=
# Secret for POST /api/revalidate (header: x-revalidate-secret).
REVALIDATE_SECRET=
